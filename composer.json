{
  "name": "tobimori/dreamform-plainkit",
  "description": "Example Kirby site for DreamForm, styled like the Kirby Panel",
  "type": "project",
  "keywords": [
    "kirby",
    "cms",
    "dreamform",
    "forms",
    "htmx"
  ],
  "homepage": "https://www.andkindness.com/dreamform",
  "support": {
    "docs": "https://www.andkindness.com/dreamform/docs",
    "source": "https://github.com/tobimori/dreamform-plainkit"
  },
  "minimum-stability": "stable",
  "require": {
    "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
    "getkirby/cms": "^5.6",
    "bnomei/kirby3-dotenv": "^5.1",
    "tobimori/kirby-dreamform": "^2.3"
  },
  "extra": {
    "kirby-cms-path": false
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    },
    "optimize-autoloader": true
  },
  "scripts": {
    "post-install-cmd": [
      "@php -r \"file_exists('.env') || file_put_contents('.env', 'CONTENT_SALT=' . bin2hex(random_bytes(32)) . PHP_EOL);\""
    ],
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S localhost:8000 vendor/getkirby/cms/router.php"
    ]
  }
}
